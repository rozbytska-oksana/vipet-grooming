# Enable only after the PHP handler and Telegram recipient are configured and tested.
NUXT_PUBLIC_BOOKING_ENABLED=false
# Relative to Nuxt app.baseURL. The PHP handler runs on the same origin.
NUXT_PUBLIC_BOOKING_ENDPOINT=api/booking.php
# Used only by the local chat-ID helper. Never use a NUXT_PUBLIC_ prefix for the token.
VIPET_TELEGRAM_BOT_TOKEN=

# Set the verified HTTPS origin when the production domain is confirmed.
NUXT_PUBLIC_SITE_URL=
# Enable only for the public commercial site after release checks.
NUXT_PUBLIC_SITE_INDEXABLE=false
